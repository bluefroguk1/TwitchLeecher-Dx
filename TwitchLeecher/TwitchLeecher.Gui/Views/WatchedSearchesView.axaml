<UserControl x:Class="TwitchLeecher.Gui.Views.WatchedSearchesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:interfaces="clr-namespace:TwitchLeecher.Gui.Interfaces"
             xmlns:models="clr-namespace:TwitchLeecher.Core.Models;assembly=TwitchLeecher.Core"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             x:DataType="viewModels:WatchedSearchesViewModel">
    <!-- Settings > Watched searches. Self-contained: give it a WatchedSearchesViewModel as DataContext and drop it in. -->
    <UserControl.Styles>
        <Style Selector="Button.ws">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ws:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.ws.accent">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ws.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.ws avalonia|Icon">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style Selector="ComboBox.ws, TextBox.ws, NumericUpDown.ws">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.search">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.search.off">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Activity kinds: accent by default (PAUSED, FIRST RUN). -->
        <Style Selector="TextBlock.kind">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.kind.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.kind.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.kind.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.off">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <!-- Heading + master switch -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Watched searches" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="On" FontWeight="SemiBold" IsChecked="{Binding Enabled}"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- Status: last/next check, interval, check now -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Ellipse Grid.Column="0" Classes="dot" Classes.off="{Binding !Enabled}" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="Every" Classes="muted" FontSize="13" VerticalAlignment="Center"
                           Margin="10,0,8,0" />
                <ComboBox Grid.Column="3" Classes="ws" MinWidth="90" ItemsSource="{Binding IntervalOptions}"
                          SelectedItem="{Binding SelectedInterval}" />
                <Button Grid.Column="4" Classes="ws" Margin="10,0,0,0" Command="{Binding CheckNowCommand}">
                    <StackPanel Orientation="Horizontal">
                        <avalonia:Icon Value="fa-solid fa-arrows-rotate" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Searches -->
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="SEARCHES" Classes="caption" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ws accent" Content="+ Add watched search" FontSize="13"
                        Command="{Binding AddCommand}" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSearches}"
                       Text="No watched searches yet. Add one here, or search a channel and press Watch this search." />
            <ItemsControl ItemsSource="{Binding Searches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchedSearch">
                        <Border Classes="search" Classes.off="{Binding !Active}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Classes="tag">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding LatestResult}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="When found" Classes="muted" FontSize="11" />
                                        <ComboBox Classes="ws" Width="160" SelectedIndex="{Binding WhenFoundIndex}">
                                            <ComboBoxItem Content="Download now" />
                                            <ComboBoxItem Content="Add to queue, paused" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="ws" Content="Edit" Margin="10,0,0,0"
                                            Command="{Binding $parent[ItemsControl].((viewModels:WatchedSearchesViewModel)DataContext).EditCommand}"
                                            CommandParameter="{Binding}" />
                                    <CheckBox Grid.Column="3" Content="Active" FontSize="12" Margin="10,0,0,0"
                                              IsChecked="{Binding Active}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Editor -->
                                <Grid IsVisible="{Binding IsEditing}" ColumnDefinitions="Auto,10,*"
                                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,10,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" Classes="muted"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="2" Classes="ws" Watermark="channel name"
                                             Text="{Binding Channel}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" Classes="muted"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="2" Classes="ws" MinWidth="160"
                                              SelectedIndex="{Binding VideoTypeIndex}">
                                        <ComboBoxItem Content="Broadcasts" />
                                        <ComboBoxItem Content="Highlights" />
                                        <ComboBoxItem Content="Uploads" />
                                        <ComboBoxItem Content="Clips" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Minimum views" Classes="muted"
                                               VerticalAlignment="Center" IsVisible="{Binding IsClip}" />
                                    <NumericUpDown Grid.Row="4" Grid.Column="2" Classes="ws" Width="120"
                                                   HorizontalAlignment="Left" Minimum="0" Maximum="10000000"
                                                   Value="{Binding MinViews}" IsVisible="{Binding IsClip}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Quality" Classes="muted"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="6" Grid.Column="2" Classes="ws" MinWidth="160"
                                              ItemsSource="{Binding $parent[ItemsControl].((viewModels:WatchedSearchesViewModel)DataContext).QualityOptions}"
                                              SelectedIndex="{Binding QualityIndex}" />

                                    <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" Spacing="8">
                                        <Button Classes="ws" Content="Remove"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                Command="{Binding $parent[ItemsControl].((viewModels:WatchedSearchesViewModel)DataContext).RemoveCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="ws accent" Content="Done"
                                                Command="{Binding $parent[ItemsControl].((viewModels:WatchedSearchesViewModel)DataContext).EditCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Recent activity, from auto_download.log -->
        <StackPanel Spacing="6">
            <TextBlock Text="RECENT ACTIVITY" Classes="caption" />
            <TextBlock Classes="muted" IsVisible="{Binding !HasActivity}"
                       Text="Nothing yet. Activity shows here after the first check." />
            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8"
                    IsVisible="{Binding HasActivity}">
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="interfaces:WatchedActivity">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,7">
                                <Grid ColumnDefinitions="52,80,*">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="muted" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" Classes="kind"
                                               Classes.success="{Binding IsSuccess}"
                                               Classes.warning="{Binding IsWarning}"
                                               Classes.error="{Binding IsError}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Checks only run while Twitch Leecher is open. Videos that already exist when a search is first checked are marked as seen, not downloaded." />
    </StackPanel>
</UserControl>
