<UserControl x:Class="TwitchLeecher.Gui.Views.DownloadView"
             x:Name="control"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:controls="clr-namespace:TwitchLeecher.Gui.Controls"
             x:DataType="viewModels:DownloadViewModel">
    <Design.DataContext>
        <viewModels:DownloadViewModel />
    </Design.DataContext>

    <!-- colours come only from the shared theme keys (App.axaml) so every theme keeps working -->
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderActiveBrush}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- hover/pressed shades of the accent, whatever the theme's accent is -->
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.timecode">
            <!-- translucent overlay on the preview picture, readable on every theme -->
            <Setter Property="Background" Value="#BF000000" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style Selector="Border.timecode TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="620" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="12"
                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
            <DockPanel>
                <!-- Header: thumbnail, title, channel · date · length -->
                <Border DockPanel.Dock="Top" Padding="20,18" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="128" Height="72" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource InputBackgroundBrush}" Margin="0,0,14,0">
                            <Image Source="{Binding DownloadParams.Video.Thumbnail^}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Top" Spacing="4">
                            <TextBlock Text="{Binding DownloadParams.Video.Title}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VideoDetails}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Footer: Cancel, Download -->
                <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Classes="primary" Content="⤓ Download" Command="{Binding DownloadCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="20,18" Spacing="16">
                    <!-- Quality | Save to -->
                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="label" Text="QUALITY" />
                            <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Quality"
                                      ItemsSource="{Binding DownloadParams.Qualities}"
                                      SelectedItem="{Binding DownloadParams.SelectedQuality}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="SAVE TO" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,0" FontSize="13"
                                        Content="Change" Command="{Binding ChooseCommand}" />
                                <TextBox Text="{Binding DownloadParams.Folder, Mode=OneWay}" IsReadOnly="True"
                                         AutomationProperties.Name="Save to" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- File name, always editable, with reset to template -->
                    <StackPanel>
                        <TextBlock Classes="label" Text="FILE NAME" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Width="36" Padding="0"
                                    HorizontalContentAlignment="Center" Content="↺"
                                    Command="{Binding ResetFilenameCommand}"
                                    ToolTip.Tip="Reset to the file name template from Settings"
                                    AutomationProperties.Name="Reset file name to template" />
                            <TextBox Text="{Binding DownloadParams.Filename}" AutomationProperties.Name="File name" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Part to download (needs conversion; never for clips) -->
                    <StackPanel Spacing="8" IsVisible="{Binding DownloadParams.CanCrop}">
                        <TextBlock Classes="label" Text="PART TO DOWNLOAD" Margin="0" />

                        <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding HasPreviews}">
                            <Border Grid.Column="0" Height="140" CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="{Binding StartPreview}" Stretch="UniformToFill" />
                                    <Border Classes="timecode" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="START" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                    <Border Classes="timecode" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding RangeStartText}" FontSize="12" />
                                    </Border>
                                </Panel>
                            </Border>
                            <Border Grid.Column="2" Height="140" CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                                <Panel>
                                    <Image Source="{Binding EndPreview}" Stretch="UniformToFill" />
                                    <Border Classes="timecode" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="END" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                    <Border Classes="timecode" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding RangeEndText}" FontSize="12" />
                                    </Border>
                                </Panel>
                            </Border>
                        </Grid>

                        <controls:RangeStrip Height="44" Cursor="SizeWestEast"
                                             AutomationProperties.Name="Part to download"
                                             TrackBrush="{DynamicResource InputBackgroundBrush}"
                                             AccentBrush="{DynamicResource AccentBrush}"
                                             GapBrush="{DynamicResource CardBackgroundBrush}"
                                             Frames="{Binding PreviewFrames}"
                                             Duration="{Binding VideoSeconds}"
                                             Start="{Binding RangeStart}"
                                             End="{Binding RangeEnd}" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                                       FontWeight="SemiBold" Text="{Binding RangeSummary}"
                                       ToolTip.Tip="Estimated size, based on the quality's advertised bitrate. The real file can differ." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="From" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox Width="90" MinHeight="32" Padding="0" HorizontalContentAlignment="Center" MaxLength="8"
                                         TextInput="TimeBox_TextInput"
                                         Text="{Binding RangeStartText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="From" />
                                <TextBlock Text="to" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox Width="90" MinHeight="32" Padding="0" HorizontalContentAlignment="Center" MaxLength="8"
                                         TextInput="TimeBox_TextInput"
                                         Text="{Binding RangeEndText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="To" />
                                <Button Classes="link" Content="Whole video" VerticalAlignment="Center"
                                        Command="{Binding WholeVideoCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- Muted parts -->
                    <Border IsVisible="{Binding ShowMutedPartsWarning}" Padding="10,8" CornerRadius="6"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource WarningColor}" Opacity="0.12" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource WarningColor}" Opacity="0.4" />
                        </Border.BorderBrush>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="⚠" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Classes="link" Content="What does this mean?"
                                    VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="13"
                                                   Text="Twitch silenced these parts, usually because of copyrighted music. The download works, but those parts have no sound. If conversion fails or the audio is wrong, turn off conversion in Settings and download again." />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="Some parts of this video are muted by Twitch." FontSize="13"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Extras -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="EXTRAS" Margin="0" />
                        <!-- clips have no chat replay -->
                        <CheckBox Content="Save chat as text" IsChecked="{Binding DownloadParams.DownloadChat}"
                                  IsVisible="{Binding !DownloadParams.Video.IsClip}"
                                  ToolTip.Tip="Saves the chat next to the video as timestamped text, matching the part you download." />
                        <CheckBox Content="Save video details" IsChecked="{Binding DownloadParams.SaveVodInfo}"
                                  ToolTip.Tip="Saves title, channel, id, link, date, length and quality in a small file next to the video." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </ScrollViewer>
</UserControl>
