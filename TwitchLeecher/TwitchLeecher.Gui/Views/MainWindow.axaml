<Window x:Class="TwitchLeecher.Gui.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TwitchLeecher.Gui.ViewModels"
        xmlns:view="clr-namespace:TwitchLeecher.Gui.Views"
        xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
        xmlns:models="clr-namespace:TwitchLeecher.Core.Models;assembly=TwitchLeecher.Core"
        Classes="TlWindow"
        Icon="/Assets/TL_Icon.ico"
        Width="780"
        Height="920"
        MinWidth="780"
        MinHeight="600"
        x:DataType="vm:MainWindowVM"
        Title="{Binding Title}">
    <Design.DataContext>
        <vm:MainWindowVM />
    </Design.DataContext>
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:AuthViewModel}">
            <view:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
            <view:LoadingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
            <view:SearchResultView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <view:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
            <view:DownloadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <view:DownloadsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreferencesViewModel}">
            <view:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoViewModel}">
            <view:InfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <view:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubOnlyViewModel}">
            <view:SubOnlyView />
        </DataTemplate>
    </Window.DataTemplates>
    <Window.Styles>
        <!-- Header palette from the redesign; local to this window so other screens keep their own styles -->
        <Style Selector="Border.TlHeader TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.TlHeaderTab TextBlock.TabLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.TlHeaderTab avalonia|Icon">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab.active avalonia|Icon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab.active TextBlock.TabLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TlHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderButton.on">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Button.TlHeaderButton.on avalonia|Icon">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.TlToast">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TlToast.shown">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Classes="TlHeader" Height="56" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
                <!-- the logo and name go home (Search), like most apps -->
                <Button Grid.Column="0" Command="{Binding ShowSearchCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0" VerticalAlignment="Center" Cursor="Hand"
                        ToolTip.Tip="Go to Search" AutomationProperties.Name="Twitch Leecher, go to Search">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="/Assets/TL_Icon.png" Width="28" Height="28" />
                        <TextBlock Text="Twitch Leecher" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0"
                            IsVisible="{Binding IsAuthenticated}">
                    <Button Classes="TlHeaderTab" Classes.active="{Binding IsSearchActive}"
                            Command="{Binding ShowSearchCommand}"
                            ToolTip.Tip="Search for videos"
                            AutomationProperties.Name="Search">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <avalonia:Icon Value="fa-solid fa-magnifying-glass" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Classes="TabLabel" Text="Search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="TlHeaderTab" Classes.active="{Binding IsDownloadsActive}"
                            Command="{Binding ShowDownloadsCommand}"
                            ToolTip.Tip="Show downloads"
                            AutomationProperties.Name="{Binding DownloadsCount, StringFormat='Downloads ({0})'}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <avalonia:Icon Value="fa-solid fa-download" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Classes="TabLabel" Text="Downloads" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource DividerBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DownloadsCount, FallbackValue=0}" FontSize="12"
                                           FontWeight="Normal" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            IsVisible="{Binding IsAuthenticated}">
                    <Button Classes="TlHeaderButton" Command="{Binding ShowPreferencesCommand}"
                            ToolTip.Tip="Settings"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:Icon Value="fa-solid fa-gear" Width="12" Height="12" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="TlHeaderButton" Command="{Binding DonateCommand}"
                            IsVisible="{Binding ShowDonationButton}"
                            ToolTip.Tip="Donate"
                            AutomationProperties.Name="Donate">
                        <avalonia:Icon Value="fa-solid fa-dollar-sign" Width="14" Height="14" />
                    </Button>
                    <Button Classes="TlHeaderButton" Command="{Binding ShowInfoCommand}"
                            ToolTip.Tip="Info"
                            AutomationProperties.Name="Info">
                        <avalonia:Icon Value="fa-solid fa-circle-question" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding MainView}" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding MainView.MenuCommands}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="models:MenuCommand">

                        <Button Command="{Binding Command}" Width="{Binding Width}" Margin="0 0 10 0">
                            <StackPanel Orientation="Horizontal">
                                <avalonia:Icon Value="{Binding Icon}" Margin="0 0 10 0" />
                                <TextBlock Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </Grid>

        <!-- Toast: bottom-right, above the page's command bar; fades via the TlToast style -->
        <Border Grid.Row="1" Classes="TlToast" Classes.shown="{Binding ShowNotification}"
                IsHitTestVisible="{Binding ShowNotification}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,16,16,64"
                MaxWidth="360" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                BoxShadow="0 4 16 0 #66000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <avalonia:Icon Value="fa-solid fa-circle-info" Foreground="{DynamicResource AccentBrush}" Width="14" Height="14"
                               VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Notification}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
