<UserControl x:Class="TwitchLeecher.Gui.Views.SearchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TwitchLeecher.Gui.Converters"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:enums="clr-namespace:TwitchLeecher.Core.Enums;assembly=TwitchLeecher.Core"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="viewModels:SearchViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <Design.DataContext>
        <viewModels:SearchViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:VideoTypeToBooleanConverter x:Key="VideoTypeToBooleanConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <!-- The pop-up calendar: rounded card, quiet chevrons and weekday letters (replaces the built-in look) -->
            <ControlTheme x:Key="TlCalendarItemTheme" TargetType="CalendarItem">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" Padding="8">
                                <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto">
                                    <Grid.Styles>
                                        <Style Selector="Button.CalendarHeader">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Style>
                                        <Style Selector="Button.CalendarHeader:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.CalendarNavigation">
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="Width" Value="32" />
                                        </Style>
                                        <Style Selector="Button.CalendarNavigation > Path">
                                            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                        </Style>
                                        <Style Selector="Button.CalendarNavigation:pointerover > Path">
                                            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Style>
                                    </Grid.Styles>

                                    <Button Name="PART_PreviousButton" Classes="CalendarHeader CalendarNavigation"
                                            HorizontalAlignment="Left" IsVisible="False">
                                        <Path Width="7" Height="12" Data="M6,1 L1.5,6 L6,11" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Name="PART_HeaderButton" Grid.Column="1" Classes="CalendarHeader"
                                            Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            FontSize="13" FontWeight="SemiBold" />
                                    <Button Name="PART_NextButton" Grid.Column="2" Classes="CalendarHeader CalendarNavigation"
                                            HorizontalAlignment="Right" IsVisible="False">
                                        <Path Width="7" Height="12" Data="M1.5,1 L6,6 L1.5,11" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <Grid Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" IsVisible="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" IsVisible="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Setter Property="DayTitleTemplate">
                    <Template x:DataType="x:String">
                        <TextBlock Margin="0,4,0,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding}" />
                    </Template>
                </Setter>
            </ControlTheme>

            <!-- Date field: one bordered box, with a card-coloured calendar button on the right -->
            <ControlTheme x:Key="TlDatePickerTheme" TargetType="CalendarDatePicker">
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True" MinHeight="36">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="PART_TextBox" Grid.Column="0"
                                         Padding="{TemplateBinding Padding}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                         Background="Transparent" BorderThickness="0" MinHeight="0"
                                         DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                                         UseFloatingWatermark="{TemplateBinding UseFloatingWatermark}"
                                         Watermark="{TemplateBinding Watermark}" />
                                <Button Name="PART_Button" Grid.Column="1" Width="36" Padding="0" Focusable="False" Cursor="Hand"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <!-- right corners follow the field's rounded border (6px outer, 1px line) -->
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="0,5,5,0">
                                                <avalonia:Icon Value="fa-regular fa-calendar" Width="15" Height="15"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}" IsLightDismissEnabled="True">
                                    <Calendar Name="PART_Calendar"
                                              DisplayDate="{TemplateBinding DisplayDate}"
                                              DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                              DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                              FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                              IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                              SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}">
                                        <Calendar.Styles>
                                            <Style Selector="CalendarItem">
                                                <Setter Property="Theme" Value="{StaticResource TlCalendarItemTheme}" />
                                            </Style>
                                        </Calendar.Styles>
                                    </Calendar>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^ /template/ Button#PART_Button:pointerover">
                    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <!-- Segmented switch and filter chips: radio buttons drawn as pills -->
        <Style Selector="RadioButton.seg, RadioButton.chip">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg">
            <!-- no outline of its own: the dark track around the pair draws the only border -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.chip">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="RadioButton.chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="RadioButton.chip:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.favchip">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.recent">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*">

        <!-- Sidebar: the search form -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="16">

                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="3">
                        <Grid ColumnDefinitions="*,*">
                            <RadioButton Grid.Column="0" Classes="seg" GroupName="SearchSource" Content="Channel"
                                         AutomationProperties.Name="Search a channel"
                                         IsChecked="{Binding IsLinksMode, Converter={StaticResource InverseBooleanConverter}}" />
                            <RadioButton Grid.Column="1" Classes="seg" GroupName="SearchSource" Content="Links / IDs"
                                         AutomationProperties.Name="Search links or video IDs"
                                         IsChecked="{Binding IsLinksMode}" />
                        </Grid>
                    </Border>

                    <!-- Channel source -->
                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <!-- Enter searches from the channel field only: on the whole page it also swallowed
                             Enter in the Links box, which then could not take more than one line -->
                        <StackPanel.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </StackPanel.KeyBindings>
                        <TextBlock Classes="label" Text="CHANNEL" />
                        <Grid ColumnDefinitions="*">
                            <AutoCompleteBox Grid.Column="0" Height="36"
                                             Watermark="Channel name"
                                             AutomationProperties.Name="Channel name"
                                             ItemsSource="{Binding FavChannels, Mode=OneWay}"
                                             MinimumPrefixLength="0"
                                             IsDropDownOpen="{Binding IsDropdownOpen, Mode=TwoWay}"
                                             Text="{Binding SearchParams.Channel}"
                                             IsTextCompletionEnabled="True" />
                        </Grid>
                        <StackPanel IsVisible="{Binding HasFavChannels}">
                            <ItemsControl ItemsSource="{Binding FavChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button Classes="favchip"
                                                Content="{Binding StringFormat='&#x2605; {0}'}"
                                                ToolTip.Tip="Search this channel"
                                                Command="{Binding $parent[UserControl].((viewModels:SearchViewModel)DataContext).PickFavouriteCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="favchip" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Left"
                                    Content="&#x2605; All favourites"
                                    ToolTip.Tip="Search every favourite channel at once"
                                    Command="{Binding SearchFavouritesCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Links / IDs source -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsLinksMode}">
                        <TextBlock Classes="label" Text="LINKS / VIDEO IDS" />
                        <TextBox Classes="TlMultilineTextBox" Height="160" Padding="10,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Links or video IDs, one per line"
                                 Watermark="https://www.twitch.tv/videos/123456789&#10;123456789"
                                 Text="{Binding LinksText, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <TextBlock Classes="label" Text="TYPE" />
                        <WrapPanel>
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Broadcasts"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Broadcast}}" />
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Highlights"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Highlight}}" />
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Uploads"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Upload}}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <TextBlock Classes="label" Text="SHOW" />
                        <!-- Quick picks as pills (four in one row, "Last N videos" below); the fields below appear
                             for Last N videos and Custom -->
                        <StackPanel Spacing="0">
                            <UniformGrid Columns="4">
                                <UniformGrid.Styles>
                                    <Style Selector="RadioButton.chip">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                    </Style>
                                </UniformGrid.Styles>
                                <RadioButton Classes="chip" GroupName="SearchShow" Content="Today"
                                             IsChecked="{Binding ShowTodayPill}" />
                                <RadioButton Classes="chip" GroupName="SearchShow" Content="7 days"
                                             AutomationProperties.Name="Last 7 days"
                                             IsChecked="{Binding Show7DaysPill}" />
                                <RadioButton Classes="chip" GroupName="SearchShow" Content="30 days"
                                             AutomationProperties.Name="Last 30 days"
                                             IsChecked="{Binding Show30DaysPill}" />
                                <RadioButton Classes="chip" GroupName="SearchShow" Content="Custom"
                                             AutomationProperties.Name="Custom date range"
                                             IsChecked="{Binding ShowCustomPill}" />
                            </UniformGrid>
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="Last N videos"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.Name="Last N videos"
                                         IsChecked="{Binding ShowLastVodsPill}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLastVods}">
                            <TextBlock Text="Last" VerticalAlignment="Center" />
                            <NumericUpDown Minimum="1" Maximum="999" Width="110" FormatString="0"
                                           AutomationProperties.Name="Number of videos"
                                           Value="{Binding SearchParams.LoadLastVods}"
                                           HorizontalContentAlignment="Center" />
                            <TextBlock Text="videos" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,6,Auto" IsVisible="{Binding IsCustomRange}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From" VerticalAlignment="Center" />
                            <CalendarDatePicker Grid.Row="0" Grid.Column="1" Classes="TlDatePicker" Theme="{StaticResource TlDatePickerTheme}"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="From date" Watermark="Choose a date"
                                                x:Name="FromPicker"
                                                SelectedDate="{Binding SearchParams.LoadFrom}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="To" VerticalAlignment="Center" />
                            <CalendarDatePicker Grid.Row="2" Grid.Column="1" Classes="TlDatePicker" Theme="{StaticResource TlDatePickerTheme}"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="To date" Watermark="Choose a date"
                                                DisplayDateStart="{Binding SearchParams.LoadFrom}"
                                                x:Name="ToPicker"
                                                SelectedDate="{Binding SearchParams.LoadTo}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Button Height="40" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" CornerRadius="6"
                                FontWeight="SemiBold"
                                Command="{Binding SearchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:Icon Value="fa-solid fa-magnifying-glass" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                   Text="Press Enter to search" IsVisible="{Binding !IsLinksMode}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                   Text="One link or video ID per line" IsVisible="{Binding IsLinksMode}" />
                        <Button HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                IsVisible="{Binding HasResults}"
                                Command="{Binding BackToResultsCommand}"
                                Content="{Binding BackToResultsText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Empty state -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/TL_Icon.png" Width="96" Height="96" HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding ProductTitle, Mode=OneTime}" />
                <TextBlock Text="The Broadcast Downloader" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />

                <StackPanel Width="280" Margin="0,28,0,0" Spacing="6" IsVisible="{Binding HasRecentSearches}">
                    <TextBlock Classes="label" Text="RECENT SEARCHES" />
                    <ItemsControl ItemsSource="{Binding RecentSearches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentSearchItem">
                                <Button Classes="recent"
                                        ToolTip.Tip="Run this search again"
                                        Command="{Binding $parent[UserControl].((viewModels:SearchViewModel)DataContext).RunRecentSearchCommand}"
                                        CommandParameter="{Binding Params}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="&#x2192;" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
