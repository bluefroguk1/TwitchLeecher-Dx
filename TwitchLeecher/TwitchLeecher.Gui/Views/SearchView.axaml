<UserControl x:Class="TwitchLeecher.Gui.Views.SearchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TwitchLeecher.Gui.Converters"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:views="clr-namespace:TwitchLeecher.Gui.Views"
             xmlns:enums="clr-namespace:TwitchLeecher.Core.Enums;assembly=TwitchLeecher.Core"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="viewModels:SearchViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <Design.DataContext>
        <viewModels:SearchViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:VideoTypeToBooleanConverter x:Key="VideoTypeToBooleanConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <!-- Segmented switch and filter chips: radio buttons drawn as pills -->
        <Style Selector="RadioButton.seg, RadioButton.chip">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg">
            <!-- no outline of its own: the dark track around the pair draws the only border -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.chip">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="RadioButton.chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="RadioButton.chip:checked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.favchip">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- loading placeholders: a soft pulse instead of a spinner -->
        <Style Selector="Border.skeleton">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:1.3" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.recent">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*">

        <!-- Sidebar: the search form -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" Spacing="16">

                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="3">
                        <Grid ColumnDefinitions="*,*">
                            <RadioButton Grid.Column="0" Classes="seg" GroupName="SearchSource" Content="Channel"
                                         AutomationProperties.Name="Search a channel"
                                         IsChecked="{Binding IsLinksMode, Converter={StaticResource InverseBooleanConverter}}" />
                            <RadioButton Grid.Column="1" Classes="seg" GroupName="SearchSource" Content="Links / IDs"
                                         AutomationProperties.Name="Search links or video IDs"
                                         IsChecked="{Binding IsLinksMode}" />
                        </Grid>
                    </Border>

                    <!-- Channel source -->
                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <!-- Enter searches from the channel field only: on the whole page it also swallowed
                             Enter in the Links box, which then could not take more than one line -->
                        <StackPanel.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </StackPanel.KeyBindings>
                        <TextBlock Classes="label" Text="CHANNEL" />
                        <Grid ColumnDefinitions="*">
                            <AutoCompleteBox Grid.Column="0" Height="36"
                                             Watermark="Channel name"
                                             AutomationProperties.Name="Channel name"
                                             ItemsSource="{Binding FavChannels, Mode=OneWay}"
                                             MinimumPrefixLength="0"
                                             IsDropDownOpen="{Binding IsDropdownOpen, Mode=TwoWay}"
                                             Text="{Binding SearchParams.Channel}"
                                             IsTextCompletionEnabled="True" />
                        </Grid>
                        <StackPanel IsVisible="{Binding HasFavChannels}">
                            <ItemsControl ItemsSource="{Binding FavChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button Classes="favchip"
                                                Content="{Binding StringFormat='&#x2605; {0}'}"
                                                ToolTip.Tip="Search this channel"
                                                Command="{Binding $parent[UserControl].((viewModels:SearchViewModel)DataContext).PickFavouriteCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="favchip" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Left"
                                    Content="&#x2605; All favourites"
                                    ToolTip.Tip="Search every favourite channel at once"
                                    Command="{Binding SearchFavouritesCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Links / IDs source -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsLinksMode}">
                        <TextBlock Classes="label" Text="LINKS / VIDEO IDS" />
                        <TextBox Classes="TlMultilineTextBox" Height="160" Padding="10,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Links or video IDs, one per line"
                                 Watermark="https://www.twitch.tv/videos/123456789&#10;123456789"
                                 Text="{Binding LinksText, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <TextBlock Classes="label" Text="TYPE" />
                        <!-- two even columns: the pills line up and sit centred instead of wrapping ragged -->
                        <UniformGrid Columns="2">
                            <UniformGrid.Styles>
                                <Style Selector="RadioButton.chip">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </UniformGrid.Styles>
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Broadcasts"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Broadcast}}" />
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Highlights"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Highlight}}" />
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Uploads"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Upload}}" />
                            <RadioButton Classes="chip" GroupName="SearchVideoType" Content="Clips"
                                         IsChecked="{Binding SearchParams.VideoType, Converter={StaticResource VideoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Clip}}" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding !IsLinksMode}">
                        <TextBlock Classes="label" Text="SHOW" />
                        <!-- Quick picks as pills; the fields below appear for Last N videos and Custom -->
                        <WrapPanel>
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="Last N videos"
                                         AutomationProperties.Name="Last N videos"
                                         IsChecked="{Binding ShowLastVodsPill}" />
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="Today"
                                         IsChecked="{Binding ShowTodayPill}" />
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="7 days"
                                         AutomationProperties.Name="Last 7 days"
                                         IsChecked="{Binding Show7DaysPill}" />
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="30 days"
                                         AutomationProperties.Name="Last 30 days"
                                         IsChecked="{Binding Show30DaysPill}" />
                            <RadioButton Classes="chip" GroupName="SearchShow" Content="Custom"
                                         AutomationProperties.Name="Custom date range"
                                         IsChecked="{Binding ShowCustomPill}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLastVods}">
                            <TextBlock Text="Last" VerticalAlignment="Center" />
                            <NumericUpDown Minimum="1" Maximum="999" Width="110" FormatString="0"
                                           AutomationProperties.Name="Number of videos"
                                           Value="{Binding SearchParams.LoadLastVods}"
                                           HorizontalContentAlignment="Center" />
                            <TextBlock Text="videos" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,6,Auto" IsVisible="{Binding IsCustomRange}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From" VerticalAlignment="Center" />
                            <CalendarDatePicker Grid.Row="0" Grid.Column="1" Classes="TlDatePicker"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="From date" Watermark="Choose a date"
                                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                                SelectedDate="{Binding SearchParams.LoadFrom}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="To" VerticalAlignment="Center" />
                            <CalendarDatePicker Grid.Row="2" Grid.Column="1" Classes="TlDatePicker"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="To date" Watermark="Choose a date"
                                                DisplayDateStart="{Binding SearchParams.LoadFrom}"
                                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                                SelectedDate="{Binding SearchParams.LoadTo}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Button Height="40" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" CornerRadius="6"
                                FontWeight="SemiBold"
                                Command="{Binding SearchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:Icon Value="fa-solid fa-magnifying-glass" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                   Text="One link or video ID per line" IsVisible="{Binding IsLinksMode}" />
                    </StackPanel>

                    <!-- Recent searches sit right under the Search button -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasRecentSearches}">
                        <TextBlock Classes="label" Text="RECENT SEARCHES" />
                        <ItemsControl ItemsSource="{Binding RecentSearches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:RecentSearchItem">
                                    <Button Classes="recent"
                                            ToolTip.Tip="Run this search again"
                                            Command="{Binding $parent[UserControl].((viewModels:SearchViewModel)DataContext).RunRecentSearchCommand}"
                                            CommandParameter="{Binding Params}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="&#x2192;" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right-hand pane: empty state, loading, no results, or the results -->
        <Grid Grid.Column="1">

            <Panel IsVisible="{Binding ShowResults}">
                <views:SearchResultView DataContext="{Binding Results}" />
            </Panel>

            <!-- Loading: a thin progress bar and pulsing placeholder cards -->
            <Grid IsVisible="{Binding IsSearching}" RowDefinitions="Auto,*">
                <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" MinHeight="3"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource DividerBrush}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="skeleton" Width="28" Height="28" CornerRadius="14" />
                            <TextBlock Text="Searching Twitch&#x2026;" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SkeletonCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <Border Width="236" Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True"
                                            Background="{DynamicResource CardBackgroundBrush}">
                                        <StackPanel>
                                            <Border Classes="skeleton" Height="131" CornerRadius="0" />
                                            <StackPanel Margin="10" Spacing="8">
                                                <Border Classes="skeleton" Height="12" CornerRadius="4" />
                                                <Border Classes="skeleton" Height="12" Width="140" HorizontalAlignment="Left" CornerRadius="4" />
                                                <Border Classes="skeleton" Height="30" CornerRadius="6" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- A finished search that found nothing -->
            <StackPanel IsVisible="{Binding ShowNoResults}" Margin="32" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <avalonia:Icon Value="fa-solid fa-film" Width="36" Height="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="No videos found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Try a different channel, video type or date range." Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Empty state -->
            <ScrollViewer IsVisible="{Binding ShowEmptyState}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/TL_Icon.png" Width="96" Height="96" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding ProductTitle, Mode=OneTime}" />
                    <TextBlock Text="The Broadcast Downloader" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
