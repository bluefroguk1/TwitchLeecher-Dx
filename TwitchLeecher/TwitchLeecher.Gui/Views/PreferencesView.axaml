<UserControl x:Class="TwitchLeecher.Gui.Views.PreferencesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TwitchLeecher.Gui.Converters"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:views="clr-namespace:TwitchLeecher.Gui.Views"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:enums="clr-namespace:TwitchLeecher.Core.Enums;assembly=TwitchLeecher.Core"
             x:DataType="viewModels:PreferencesViewModel">
    <UserControl.Resources>
        <converters:VideoTypeToBooleanConverter x:Key="videoTypeToBooleanConverter" />
        <converters:LoadLimitToBooleanConverter x:Key="loadLimitToBooleanConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- side menu: one TabItem per section -->
        <Style Selector="TabControl#Sections TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TabControl#Sections TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        </Style>
        <Style Selector="TabControl#Sections TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="TabControl#Sections TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>

        <!-- section pages would otherwise inherit the menu item's selected look -->
        <Style Selector="TabControl#Sections > TabItem > ScrollViewer">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TabControl#Sections TextBox, TabControl#Sections ComboBox, TabControl#Sections AutoCompleteBox, TabControl#Sections NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TabControl#Sections TextBox:focus, TabControl#Sections ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderActiveBrush}" />
        </Style>

        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="24,20" />
            <Setter Property="Spacing" Value="18" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- keeps keyboard focus (and the caret) in the file name box -->
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wildcard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- side menu background; the TabControl strip sits on top of it -->
        <Border Grid.Row="0" Width="190" HorizontalAlignment="Left" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" />

        <!-- Adding a section = one more <TabItem Header="..."> holding a StackPanel.section. -->
        <TabControl Grid.Row="0" x:Name="Sections" TabStripPlacement="Left" Padding="0" Background="Transparent"
                    SelectedIndex="{Binding SelectedSectionIndex}">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2" Width="170" Margin="10,16" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="h1" Text="General" />

                        <CheckBox IsChecked="{Binding CurrentPreferences.AppCheckForUpdates}">
                            <StackPanel>
                                <TextBlock Text="Check for updates" />
                                <TextBlock Classes="sub" Text="Tell me when a new version of Twitch Leecher is out" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CurrentPreferences.AppShowDonationButton}">
                            <StackPanel>
                                <TextBlock Text="Show the donation button" />
                                <TextBlock Classes="sub" Text="The $ button in the title bar" />
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Classes="field">
                            <CheckBox IsChecked="{Binding CurrentPreferences.MiscUseExternalPlayer}">
                                <StackPanel>
                                    <TextBlock Text="Play videos in an external player" />
                                    <TextBlock Classes="sub" Text="For example VLC, instead of opening them in the browser" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Classes="label" Text="VIDEO PLAYER" Margin="0,6,0,0" />
                            <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                                <TextBox Grid.Column="0" IsReadOnly="True"
                                         Text="{Binding CurrentPreferences.MiscExternalPlayer, Mode=OneWay}" />
                                <Button Grid.Column="2" Classes="outline" Content="Browse"
                                        Command="{Binding ChooseExternalPlayerCommand}" />
                                <Button Grid.Column="4" Classes="outline" ToolTip.Tip="Clear"
                                        Command="{Binding ClearExternalPlayerCommand}">
                                    <avalonia:Icon Value="fa-solid fa-eraser" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- the save bar only shows once something changed, so reset needs a way in from a clean state -->
                        <Button Classes="link" Content="Reset all settings to defaults…" FontSize="13"
                                Command="{Binding DefaultsCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Search">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="h1" Text="Search" />

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="FAVOURITE CHANNELS" />
                            <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto">
                                <AutoCompleteBox Grid.Column="0"
                                                 ItemsSource="{Binding CurrentPreferences.SearchFavouriteChannels, Mode=OneWay}"
                                                 MinimumPrefixLength="0"
                                                 IsDropDownOpen="{Binding IsChannelDropDownOpen, Mode=TwoWay}"
                                                 Text="{Binding CurrentPreferences.SearchChannelName}"
                                                 IsTextCompletionEnabled="True" />
                                <Button Grid.Column="2" Classes="TlMiniButton" ToolTip.Tip="Show favourites"
                                        Command="{Binding OpenDropdownCommand}">
                                    <avalonia:Icon Value="fa-solid fa-bars" Width="11" Height="11" />
                                </Button>
                                <Button Grid.Column="4" Classes="TlMiniButton" ToolTip.Tip="Add to favourites"
                                        Command="{Binding AddFavouriteChannelCommand}">
                                    <avalonia:Icon Value="fa-solid fa-plus" Width="11" Height="11" />
                                </Button>
                                <Button Grid.Column="6" Classes="TlMiniButton" ToolTip.Tip="Remove from favourites"
                                        Command="{Binding RemoveFavouriteChannelCommand}">
                                    <avalonia:Icon Value="fa-solid fa-minus" Width="11" Height="11" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="sub"
                                       Text="The channel shown here is pre-selected on the Search page. Use + and − to add or remove it." />
                        </StackPanel>

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="VIDEO TYPE" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton GroupName="VideoType" Content="Broadcast"
                                             IsChecked="{Binding CurrentPreferences.SearchVideoType, Converter={StaticResource videoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Broadcast}}" />
                                <RadioButton GroupName="VideoType" Content="Highlight"
                                             IsChecked="{Binding CurrentPreferences.SearchVideoType, Converter={StaticResource videoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Highlight}}" />
                                <RadioButton GroupName="VideoType" Content="Upload"
                                             IsChecked="{Binding CurrentPreferences.SearchVideoType, Converter={StaticResource videoTypeToBooleanConverter}, ConverterParameter={x:Static enums:VideoType.Upload}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="LOAD" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <RadioButton GroupName="LoadLimit" Content="Last" VerticalAlignment="Center"
                                             IsChecked="{Binding CurrentPreferences.SearchLoadLimitType, Converter={StaticResource loadLimitToBooleanConverter}, ConverterParameter={x:Static enums:LoadLimitType.Timespan}}" />
                                <NumericUpDown Minimum="1" Maximum="999" Width="110" VerticalAlignment="Center"
                                               IsEnabled="{Binding CurrentPreferences.SearchLoadLimitType, Converter={StaticResource loadLimitToBooleanConverter}, ConverterParameter={x:Static enums:LoadLimitType.Timespan}}"
                                               Value="{Binding CurrentPreferences.SearchLoadLastDays}" />
                                <TextBlock Text="days" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <RadioButton GroupName="LoadLimit" Content="Last" VerticalAlignment="Center"
                                             IsChecked="{Binding CurrentPreferences.SearchLoadLimitType, Converter={StaticResource loadLimitToBooleanConverter}, ConverterParameter={x:Static enums:LoadLimitType.LastVods}}" />
                                <NumericUpDown Minimum="1" Maximum="999" Width="110" VerticalAlignment="Center"
                                               IsEnabled="{Binding CurrentPreferences.SearchLoadLimitType, Converter={StaticResource loadLimitToBooleanConverter}, ConverterParameter={x:Static enums:LoadLimitType.LastVods}}"
                                               Value="{Binding CurrentPreferences.SearchLoadLastVods}" />
                                <TextBlock Text="videos" VerticalAlignment="Center" />
                            </StackPanel>
                            <RadioButton GroupName="LoadLimit" Content="Only today"
                                         IsChecked="{Binding CurrentPreferences.SearchLoadLimitType, Converter={StaticResource loadLimitToBooleanConverter}, ConverterParameter={x:Static enums:LoadLimitType.OnlyToday}}" />
                        </StackPanel>

                        <CheckBox IsChecked="{Binding CurrentPreferences.SearchOnStartup}">
                            <StackPanel>
                                <TextBlock Text="Search when the app starts" />
                                <TextBlock Classes="sub" Text="Runs a search with the settings above as soon as Twitch Leecher opens" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CurrentPreferences.SearchDefaultFavourites}">
                            <StackPanel>
                                <TextBlock Text="Search all favourite channels by default" />
                                <TextBlock Classes="sub"
                                           Text="The Search page opens on Favourites, and searching on start lists videos from all of them" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Download">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="h1" Text="Download" />

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="DOWNLOAD FOLDER" />
                            <Grid ColumnDefinitions="*,6,Auto">
                                <TextBox Grid.Column="0" IsReadOnly="True"
                                         Text="{Binding CurrentPreferences.DownloadFolder, Mode=OneWay}" />
                                <Button Grid.Column="2" Classes="outline" Content="Browse"
                                        Command="{Binding ChooseDownloadFolderCommand}" />
                            </Grid>
                            <CheckBox IsChecked="{Binding CurrentPreferences.DownloadSubfoldersForFav}"
                                      Content="Put favourite channels in their own subfolder" FontSize="13" />
                        </StackPanel>

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="FILE NAME" />
                            <TextBox x:Name="FileNameBox" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                     FontSize="13" Text="{Binding CurrentPreferences.DownloadFileName}" />
                            <WrapPanel Orientation="Horizontal">
                                <WrapPanel.Styles>
                                    <Style Selector="Button.chip">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                    </Style>
                                </WrapPanel.Styles>
                                <Button Classes="chip" Content="+ Channel" Tag="{}{channel}" Click="InsertWildcard" />
                                <Button Classes="chip" Content="+ Title" Tag="{}{title}" Click="InsertWildcard" />
                                <Button Classes="chip" Content="+ Date" Tag="{}{year}-{month}-{day}" Click="InsertWildcard" />
                                <Button Classes="chip" Content="+ Quality" Tag="{}{res}" Click="InsertWildcard" />
                                <Button Classes="chip" Content="+ Video ID" Tag="{}{id}" Click="InsertWildcard" />
                                <Button Classes="chip" Content="+ Crop start" Tag="{}{start}" Click="InsertWildcard" />
                                <Button Classes="link" Content="All wildcards…" Margin="4,0,0,6">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="380">
                                                <TextBlock Classes="sub" Margin="6,0,6,6"
                                                           Text="Click one to insert it at the cursor." />
                                                <Button Classes="wildcard" Tag="{}{id}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{id}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Video ID" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="54869708" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{channel}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{channel}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Channel name" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="somestreamer" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{title}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{title}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Video title" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="Speedrun practice" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{res}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{res}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Resolution" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="1920x1080" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{year}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{year}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Year" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="2026" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{month}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{month}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Month" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="11" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{day}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{day}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Day" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="16" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{hr24}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{hr24}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Hour (00-23)" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="19" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{hr}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{hr}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Hour (01-12)" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="07" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{min}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{min}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Minutes" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="30" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{sec}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{sec}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Seconds" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="05" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{apm}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{apm}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="AM/PM" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="PM" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{start}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{start}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Crop start (HHmmss)" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="001200" />
                                                    </Grid>
                                                </Button>
                                                <Button Classes="wildcard" Tag="{}{end}" Click="InsertWildcard">
                                                    <Grid ColumnDefinitions="70,*,Auto">
                                                        <TextBlock Text="{}{end}" FontFamily="Consolas,Menlo,monospace" />
                                                        <TextBlock Grid.Column="1" Text="Crop end (HHmmss)" />
                                                        <TextBlock Grid.Column="2" Classes="sub" Text="030000" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </WrapPanel>
                            <TextBlock FontSize="13" TextWrapping="Wrap">
                                <Run Text="Preview: " Foreground="{DynamicResource TextMutedBrush}" />
                                <Run Text="{Binding FilenamePreview}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="DEFAULT QUALITY" />
                            <ComboBox Width="220"
                                      ItemsSource="{Binding CurrentPreferences.DownloadDefaultQualities}"
                                      SelectedItem="{Binding CurrentPreferences.DownloadDefaultQuality}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="sub"
                                       Text="If a video doesn't have it, the next lower quality is picked (or the next higher if there is none lower)" />
                        </StackPanel>

                        <!-- shortcut: box sits left of the label (whole label clickable), the mockup has it right-aligned; restyle if the look matters -->
                        <StackPanel Spacing="12" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding CurrentPreferences.DownloadQuickDownload}">
                                <StackPanel>
                                    <TextBlock Text="Quick download" />
                                    <TextBlock Classes="sub" Text="Skip the download dialog and use these defaults" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CurrentPreferences.DownloadRemoveCompleted}">
                                <TextBlock Text="Remove finished downloads from the queue" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CurrentPreferences.DownloadDisableConversion}">
                                <StackPanel>
                                    <TextBlock Text="Keep the original stream file" />
                                    <TextBlock Classes="sub" Text="Skips conversion to mp4; cropping is not available" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <Expander Header="Advanced: temporary folder and connections" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="18" Margin="0,8,0,0">
                                <StackPanel Classes="field">
                                    <TextBlock Classes="label" Text="TEMPORARY FOLDER" />
                                    <Grid ColumnDefinitions="*,6,Auto">
                                        <TextBox Grid.Column="0" IsReadOnly="True"
                                                 Text="{Binding CurrentPreferences.DownloadTempFolder, Mode=OneWay}" />
                                        <Button Grid.Column="2" Classes="outline" Content="Browse"
                                                Command="{Binding ChooseDownloadTempFolderCommand}" />
                                    </Grid>
                                    <TextBlock Classes="sub"
                                               Text="Holds the video parts while they download. Needs write access." />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Classes="label" Text="MAX CONNECTIONS (EXPERIMENTAL)" />
                                    <NumericUpDown Minimum="1" Maximum="25" Width="110" HorizontalAlignment="Left"
                                                   Value="{Binding CurrentPreferences.MaxConnectionCount}" />
                                    <TextBlock Classes="sub"
                                               Text="More can be faster but may crash on some networks. Try 10; drop to 3 if downloads crash. Over 15 is not recommended." />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Watched searches">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:WatchedSearchesView DataContext="{Binding WatchedSearches}" Margin="24,16" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="section">
                        <TextBlock Classes="h1" Text="Appearance" />
                        <StackPanel Classes="field">
                            <TextBlock Classes="label" Text="THEME" />
                            <ComboBox Width="220" ItemsSource="{Binding AvailableThemes}"
                                      SelectedValue="{Binding CurrentPreferences.Theme}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- save bar: only while there are unsaved changes -->
        <Border Grid.Row="1" IsVisible="{Binding HasChanges}" Padding="16,12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,10,Auto,10,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="You have unsaved changes" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ValidationMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"
                               IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="quiet" Content="Reset to defaults" Command="{Binding DefaultsCommand}" />
                <Button Grid.Column="3" Classes="outline" Content="Undo" Command="{Binding UndoCommand}" />
                <Button Grid.Column="5" Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
