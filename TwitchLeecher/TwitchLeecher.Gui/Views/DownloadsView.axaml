<UserControl x:Class="TwitchLeecher.Gui.Views.DownloadsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:models="clr-namespace:TwitchLeecher.Core.Models;assembly=TwitchLeecher.Core"
             xmlns:avalonia="using:TwitchLeecher.Gui.Controls"
             x:DataType="viewModels:DownloadsViewModel">
    <Design.DataContext>
        <viewModels:DownloadsViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="Button.dl">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="Button.dl.bar">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="Button.dl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.dl avalonia|Icon">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style Selector="Button.dl.pill">
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="ProgressBar.dl">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ProgressBar.dl.done">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="ProgressBar.dl.failed">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <!-- Status chip: a tinted layer of the state colour under text in that colour; queued is the default. -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.chip > Panel > Border">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="8,2" />
        </Style>
        <Style Selector="Border.chip.downloading > Panel > Border, Border.chip.paused > Panel > Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.22" />
        </Style>
        <Style Selector="Border.chip.downloading TextBlock, Border.chip.paused TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.chip.done > Panel > Border">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="Border.chip.done TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.chip.warning > Panel > Border">
            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="Border.chip.warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.chip.failed > Panel > Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="Border.chip.failed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <Style Selector="TextBlock.detail">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.detail.downloading">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.detail.failed">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <!-- Summary bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SummaryCounts}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SummarySize}" FontSize="13" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Watched searches pill: opens Settings at that section -->
                    <Button Grid.Column="2" Classes="dl bar pill" Command="{Binding OpenWatchedSearchesCommand}"
                            IsVisible="{Binding WatchedSearchesText, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Watched searches queue new videos while the app is open">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Classes="dot" Classes.on="{Binding WatchedSearchesOn}" Width="8" Height="8"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding WatchedSearchesText}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="dl bar" Command="{Binding PauseAllCommand}"
                            IsEnabled="{Binding CanPauseOrResume}">
                        <StackPanel Orientation="Horizontal">
                            <avalonia:Icon Value="fa-solid fa-pause" IsVisible="{Binding CanPauseAll}" />
                            <avalonia:Icon Value="fa-solid fa-play" IsVisible="{Binding !CanPauseAll}" />
                            <TextBlock Text="{Binding PauseAllText}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="dl bar" Content="Clear finished"
                            Command="{Binding ClearFinishedCommand}" IsEnabled="{Binding HasDownloads}" />
                </Grid>
                <ProgressBar Classes="dl" Height="4" CornerRadius="2" Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress}" />
            </StackPanel>
        </Border>

        <Panel>
            <TextBlock Text="No downloads yet. Pick a video in Search to add it here."
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsVisible="{Binding !HasDownloads}" />

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Downloads}" Margin="16,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TwitchVideoDownload">
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="96" Height="54" CornerRadius="4" ClipToBounds="True"
                                            Background="{DynamicResource InputBackgroundBrush}" VerticalAlignment="Top"
                                            Margin="0,0,12,0">
                                        <Image Source="{Binding DownloadParams.Video.Thumbnail^}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DownloadParams.Video.Title}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Classes.downloading="{Binding IsDownloading}"
                                                    Classes.paused="{Binding IsPaused}"
                                                    Classes.done="{Binding IsDone}"
                                                    Classes.warning="{Binding HasWarnings}"
                                                    Classes.failed="{Binding IsFailed}">
                                                <Panel>
                                                    <Border />
                                                    <TextBlock Text="{Binding StatusChip}" />
                                                </Panel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding MetaLine}" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Classes="dl" Height="6" CornerRadius="3" Minimum="0"
                                                     Maximum="100"
                                                     Classes.done="{Binding IsDone}"
                                                     Classes.failed="{Binding IsFailed}"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="detail" FontSize="12"
                                                       Classes.downloading="{Binding IsDownloading}"
                                                       Classes.failed="{Binding IsFailed}"
                                                       Text="{Binding DetailLine}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!-- Downloading -->
                                                <Button Classes="dl" IsVisible="{Binding IsDownloading}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).PauseDownloadCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <avalonia:Icon Value="fa-solid fa-pause" />
                                                        <TextBlock Text="Pause" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="dl" Content="Cancel" IsVisible="{Binding IsDownloading}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).CancelDownloadCommand}"
                                                        CommandParameter="{Binding Id}" />
                                                <!-- Queued -->
                                                <Button Classes="dl" IsVisible="{Binding IsQueued}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).MoveUpCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <avalonia:Icon Value="fa-solid fa-arrow-up" />
                                                        <TextBlock Text="Move up" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Paused -->
                                                <Button Classes="dl" IsVisible="{Binding IsPaused}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).ResumeDownloadCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <avalonia:Icon Value="fa-solid fa-play" />
                                                        <TextBlock Text="Resume" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Queued and paused -->
                                                <Button Classes="dl" Content="Remove"
                                                        IsVisible="{Binding IsQueued}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).RemoveDownloadCommand}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="dl" Content="Remove"
                                                        IsVisible="{Binding IsPaused}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).RemoveDownloadCommand}"
                                                        CommandParameter="{Binding Id}" />
                                                <!-- Done -->
                                                <Button Classes="dl" IsVisible="{Binding IsDone}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).PlayCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <avalonia:Icon Value="fa-solid fa-play" />
                                                        <TextBlock Text="Play" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Any state -->
                                                <Button Classes="dl" Content="Open folder"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).OpenDownloadFolderCommand}"
                                                        CommandParameter="{Binding Id}" />
                                                <!-- Failed or canceled -->
                                                <Button Classes="dl" IsVisible="{Binding IsFailed}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).RetryDownloadCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <avalonia:Icon Value="fa-solid fa-arrows-rotate" />
                                                        <TextBlock Text="Retry" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="dl" Content="View log" IsVisible="{Binding IsFailed}"
                                                        Command="{Binding $parent[ItemsControl].((viewModels:DownloadsViewModel)DataContext).ShowLogCommand}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
