<UserControl x:Class="TwitchLeecher.Gui.Views.SearchResultView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             x:DataType="viewModels:SearchResultViewModel"
             Classes="searchView"
             FontFamily="fonts:Inter#Inter"
             FontSize="14">
    <UserControl.Styles>
        <!-- theme colour keys only (ui-theme-keys), so New and Original themes both work -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.star.fav">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toggle.active">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- on/off switch: muted track when off, accent when on -->
        <Style Selector="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
        <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds, ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- play icon over a thumbnail while the pointer is on it (a click opens the video) -->
        <Style Selector="Border.playOverlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.thumb:pointerover Border.playOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- The toolbar stays on ONE row. As the pane narrows it shrinks in stages (classes set from SizeChanged):
             tight  = Watch and Hide downloaded lose their text (the tooltips still name them)
             tiny   = the summary goes and the title and sort box get smaller -->
        <Style Selector="Grid.toolbar.tight TextBlock.collapsible">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.toolbar.tiny TextBlock.summary">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.toolbar.tiny TextBlock.title">
            <Setter Property="MaxWidth" Value="90" />
        </Style>
        <Style Selector="Grid.toolbar.tiny ComboBox.sort">
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <!-- status colours are light in every theme, so dark text -->
            <Setter Property="Foreground" Value="{DynamicResource HeaderBackgroundBrush}" />
        </Style>
        <Style Selector="Border.badge.accent > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <!-- search summary bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <!-- One row at every width: title and summary on the left, controls on the right (see the shrink stages in the styles). -->
            <Grid x:Name="ToolbarGrid" Classes="toolbar" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center" ClipToBounds="True" MinWidth="0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True"
                                Background="{DynamicResource ControlBorderBrush}"
                                IsVisible="{Binding IsChannelSearch}">
                            <Image Source="{Binding ChannelAvatar}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Classes="title" Text="{Binding SearchTitle}" FontSize="16" FontWeight="SemiBold" MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Classes="star" Classes.fav="{Binding IsFavourite}"
                                IsVisible="{Binding IsChannelSearch}"
                                Command="{Binding ToggleFavouriteCommand}"
                                ToolTip.Tip="Favourite channel"
                                AutomationProperties.Name="Favourite channel">
                            <Panel>
                                <avalonia:Icon Value="fa-regular fa-star" IsVisible="{Binding !IsFavourite}" />
                                <avalonia:Icon Value="fa-solid fa-star" IsVisible="{Binding IsFavourite}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="muted summary" FontSize="13" Text="{Binding SearchSummary}" Margin="10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="ToolbarControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="outline" Height="30" Padding="10,0" Margin="0,0,12,0"
                            VerticalAlignment="Center" IsVisible="{Binding IsChannelSearch}"
                            Command="{Binding WatchSearchCommand}"
                            ToolTip.Tip="Check this search for new videos and download them automatically"
                            AutomationProperties.Name="Watch this search">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:Icon Value="fa-solid fa-eye" />
                            <TextBlock Classes="collapsible" Text="Watch this search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip.Tip="Hide videos already saved in your download folder">
                        <TextBlock Classes="collapsible" Text="Hide downloaded" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding HideDownloaded}" VerticalAlignment="Center" Margin="0,0,-4,0"
                                      AutomationProperties.Name="Hide downloaded" />
                    </StackPanel>
                    <ComboBox Classes="sort" Height="30" MinWidth="130" FontSize="13" Margin="0,0,10,0"
                              VerticalAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" CornerRadius="6"
                              SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="Sort">
                        <ComboBoxItem Content="Newest first" />
                        <ComboBoxItem Content="Oldest first" />
                        <ComboBoxItem Content="Longest" />
                        <ComboBoxItem Content="Most viewed" />
                    </ComboBox>
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6"
                            ClipToBounds="True" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="toggle" Classes.active="{Binding !IsListView}"
                                    Command="{Binding ShowGridCommand}" ToolTip.Tip="Grid view"
                                    AutomationProperties.Name="Grid view">
                                <avalonia:Icon Value="fa-solid fa-table-cells-large" />
                            </Button>
                            <Button Classes="toggle" Classes.active="{Binding IsListView}"
                                    Command="{Binding ShowListCommand}" ToolTip.Tip="List view"
                                    AutomationProperties.Name="List view">
                                <avalonia:Icon Value="fa-solid fa-bars" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- selection footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding DownloadSelectedCommand}"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:Icon Value="fa-solid fa-download" />
                        <TextBlock Text="{Binding DownloadSelectedLabel}" />
                    </StackPanel>
                </Button>
                <CheckBox Content="Select all" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"
                          IsChecked="{Binding AllSelected}" />
                <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center"
                           Text="{Binding SelectionSummary}" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- grid: 236px cards, 3 per row at the 780px default window width -->
                <ItemsControl ItemsSource="{Binding GridVideos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Classes.selected="{Binding IsSelected}" Width="236" Margin="6">
                                <StackPanel>
                                    <Grid Height="131">
                                        <Button Classes="thumb" Padding="0" Background="Transparent" BorderThickness="0"
                                                CornerRadius="0" Cursor="Hand"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].((viewModels:SearchResultViewModel)DataContext).ViewCommand}"
                                                CommandParameter="{Binding Id}" ToolTip.Tip="Watch on Twitch">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail^}" Stretch="UniformToFill" />
                                                <Border Classes="playOverlay" Background="#66000000" IsHitTestVisible="False">
                                                    <Border Width="44" Height="44" CornerRadius="22" Background="#B3000000"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <avalonia:Icon Value="fa-solid fa-play" Width="16" Height="16"
                                                                       Margin="3,0,0,0" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Border Background="#99000000" CornerRadius="4" Padding="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding !Live}"
                                                      MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                                      ToolTip.Tip="Select for download"
                                                      AutomationProperties.Name="Select video" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Margin="0,6,6,0">
                                            <Border Classes="badge" Background="{DynamicResource ErrorBrush}" IsVisible="{Binding Live}">
                                                <TextBlock Text="LIVE" />
                                            </Border>
                                            <Border Classes="badge accent" Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsClip}">
                                                <TextBlock Text="CLIP" />
                                            </Border>
                                            <Border Classes="badge" Background="{DynamicResource WarningBrush}" IsVisible="{Binding IsQueued}">
                                                <TextBlock Text="QUEUED" />
                                            </Border>
                                            <Border Classes="badge" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDownloaded}">
                                                <TextBlock Text="DOWNLOADED" />
                                            </Border>
                                        </StackPanel>
                                        <Border Background="#BF000000" CornerRadius="4" Padding="6,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="{Binding LengthStr}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="10" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="17.5" Height="35"
                                                   TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding MetaStr}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetaStr}" />
                                        <Button Classes="outline" Margin="0,6,0,0" Height="30"
                                                HorizontalAlignment="Stretch" IsEnabled="{Binding !Live}"
                                                Command="{Binding $parent[UserControl].((viewModels:SearchResultViewModel)DataContext).DownloadCommand}"
                                                CommandParameter="{Binding Id}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <avalonia:Icon Value="fa-solid fa-download" />
                                                <TextBlock Text="Download" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- list: one compact row per video -->
                <ItemsControl ItemsSource="{Binding ListVideos}" Margin="6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Classes.selected="{Binding IsSelected}" CornerRadius="6"
                                    Margin="0,0,0,6" Padding="8,4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding !Live}" MinWidth="0" Margin="0,0,8,0"
                                              ToolTip.Tip="Select for download"
                                              AutomationProperties.Name="Select video" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" ClipToBounds="True">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="340" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding MetaStr}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <Border Classes="badge" Background="{DynamicResource ErrorBrush}" IsVisible="{Binding Live}">
                                            <TextBlock Text="LIVE" />
                                        </Border>
                                        <Border Classes="badge accent" Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsClip}">
                                            <TextBlock Text="CLIP" />
                                        </Border>
                                        <Border Classes="badge" Background="{DynamicResource WarningBrush}" IsVisible="{Binding IsQueued}">
                                            <TextBlock Text="QUEUED" />
                                        </Border>
                                        <Border Classes="badge" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDownloaded}">
                                            <TextBlock Text="DOWNLOADED" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="{Binding LengthStr}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="4" Classes="outline" Height="28" Padding="8,0"
                                            IsEnabled="{Binding !Live}"
                                            Command="{Binding $parent[UserControl].((viewModels:SearchResultViewModel)DataContext).DownloadCommand}"
                                            CommandParameter="{Binding Id}" ToolTip.Tip="Download"
                                            AutomationProperties.Name="Download">
                                        <avalonia:Icon Value="fa-solid fa-download" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
