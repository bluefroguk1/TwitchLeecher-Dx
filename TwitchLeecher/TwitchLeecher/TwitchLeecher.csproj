<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>TwitchLeecher</RootNamespace>
        <PackageId>TwitchLeecher</PackageId>
        <LangVersion>14</LangVersion>
        <ApplicationIcon>..\Resources\Images\TL_Icon.ico</ApplicationIcon>
        <AssemblyTitle>Twitch Leecher</AssemblyTitle>
        <Product>Twitch Leecher DX</Product>
        <Description>Twitch Broadcast Downloader</Description>
        <Company>BrainySoftware</Company>
        <FileVersion>4.0.0</FileVersion>
    </PropertyGroup>

    <!-- Native AOT for Windows publishes: faster start-up, less memory, no .NET runtime to install.
         Linux publishes are unchanged for now. -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.2.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.2.0" />
        <PackageReference Include="Deadpikle.AvaloniaProgressRing" Version="0.11.0" />
    </ItemGroup>


    <ItemGroup>
      <ProjectReference Include="..\TwitchLeecher.Gui\TwitchLeecher.Gui.csproj" />
    </ItemGroup>


    <ItemGroup>
      <UpToDateCheckInput Remove="Theme\New\Constants.axaml" />
    </ItemGroup>
</Project>
